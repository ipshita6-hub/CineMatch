# ---- Database -------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://localhost:5432/movierec
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/movierec_test

# ---- Auth -----------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Optional movie metadata enrichment -----------------------------------
# The application is fully functional without this. When absent, genre-based
# placeholder artwork is used and no external calls are made.
TMDB_API_KEY=

# ---- API ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
RECOMMENDATION_CACHE_TTL=300
LOG_LEVEL=INFO
